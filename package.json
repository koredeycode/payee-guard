{
  "name": "aevum-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Starter kit for building on QDay Aevum testnet: Foundry contracts, a Next.js app and TypeScript examples.",
  "license": "MIT",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "example": "pnpm --filter examples run",
    "check:shanghai": "node tools/check-shanghai.mjs contracts/out",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed": "tsx scripts/seed-identities.ts",
    "demo": "tsx scripts/demo-flow.ts",
    "verify:submission": "tsx scripts/verify-submission.ts",
    "read:events": "tsx scripts/read-events.ts"
  },
  "pnpm": {
    "overrides": {
      "@base-org/account": "2.2.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "viem": "^2.57.12",
    "typescript": "^5.9.3"
  }
}
